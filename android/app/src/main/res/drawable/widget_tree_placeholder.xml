<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFE9F6EA" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <item android:left="14dp" android:top="12dp" android:right="14dp" android:bottom="34dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="120dp"
                android:centerX="50%"
                android:centerY="35%"
                android:startColor="#FFF9C6D8"
                android:endColor="#FFEFA4C0" />
        </shape>
    </item>

    <item android:left="48dp" android:top="56dp" android:right="48dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF6D4C41" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>