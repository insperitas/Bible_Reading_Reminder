<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget provider metadata.
  minWidth / minHeight target a 4×2 cell grid (approx 250×110 dp at standard density).
  updatePeriodMillis = 0 — updates are driven by WorkManager, not the OS poll timer
  (OS minimum is 30 min anyway; WorkManager gives us finer control).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/bible_widget"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
