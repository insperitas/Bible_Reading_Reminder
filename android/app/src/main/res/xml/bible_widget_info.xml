<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget provider metadata.
  Baseline preset targets a 2x4 cell grid.
  updatePeriodMillis = 0 — updates are driven by WorkManager, not the OS poll timer
  (OS minimum is 30 min anyway; WorkManager gives us finer control).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:minWidth="146dp"
  android:minHeight="294dp"
    android:targetCellWidth="2"
    android:targetCellHeight="4"
  android:minResizeWidth="146dp"
  android:minResizeHeight="294dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/bible_widget"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="none"
    android:widgetCategory="home_screen" />
