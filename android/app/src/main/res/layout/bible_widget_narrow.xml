<?xml version="1.0" encoding="utf-8"?>
<!--
  Compact widget layout for narrow launchers (e.g. 1x3-like spans).
  Keeps the tree image visible by reducing fixed-height controls.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="2dp"
    android:background="@drawable/widget_background">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_tree_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_tree_placeholder"
            android:contentDescription="@string/widget_character_desc" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_date_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="7sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/widget_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="7sp"
                android:textColor="@color/widget_text_secondary"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_water"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_gravity="bottom"
            android:layout_margin="2dp"
            android:background="@drawable/widget_button_background"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_btn_read_compact"
                android:textSize="7sp"
                android:maxLines="1"
                android:textColor="@color/widget_cta_text"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_btn_feed"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone"
        android:layout_marginTop="0dp"
        android:orientation="horizontal" />

</LinearLayout>
