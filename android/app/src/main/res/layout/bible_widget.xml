<?xml version="1.0" encoding="utf-8"?>
<!--
  Portrait widget: tree image fills the top, small date/streak row, two stacked buttons.
  RemoteViews supported types: LinearLayout, ImageView, TextView.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="4dp"
    android:background="@drawable/widget_background">

    <!-- Tree image with overlaid actions -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_tree_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_tree_placeholder"
            android:contentDescription="@string/widget_character_desc" />

        <!-- Date + streak in top overlay to free vertical space for the tree -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_date_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/widget_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="8sp"
                android:textColor="@color/widget_text_secondary"
                android:fontFamily="sans-serif" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="2dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_btn_water"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_button_background"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_btn_water"
                    android:textSize="8sp"
                    android:maxLines="1"
                    android:textColor="@color/widget_cta_text"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_btn_feed"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:background="@drawable/widget_button_background"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_btn_feed"
                    android:textSize="8sp"
                    android:maxLines="1"
                    android:textColor="@color/widget_cta_text"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
