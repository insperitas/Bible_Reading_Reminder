<?xml version="1.0" encoding="utf-8"?>
<!--
  4×2 home screen widget layout.
  Top row : date label on the left, tree leaf/flower stats on the right.
  Bottom row: four equal action buttons — Daily Text | My Tree | Settings | + Extra
  RemoteViews only supports a limited view set (LinearLayout, TextView, etc.).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_background">

    <!-- ── Header row ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Date + streak (left) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_date_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:fontFamily="sans-serif" />

            <!-- Streak — hidden when 0 -->
            <TextView
                android:id="@+id/widget_streak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary"
                android:fontFamily="sans-serif" />

        </LinearLayout>

        <!-- Tree stats (right): leaves + flowers -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/widget_leaf_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/widget_flower_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary"
                android:fontFamily="sans-serif" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Action buttons row ─────────────────────────────────────────── -->
    <!-- Each button is a LinearLayout (min 44dp touch target). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <!-- 1 · Daily Text -->
        <LinearLayout
            android:id="@+id/widget_btn_daily_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_button_background"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_btn_daily_text"
                android:textSize="9sp"
                android:textColor="@color/widget_cta_text"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center"
                android:maxLines="2" />

        </LinearLayout>

        <View android:layout_width="4dp" android:layout_height="match_parent" />

        <!-- 2 · My Tree -->
        <LinearLayout
            android:id="@+id/widget_btn_tree"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_button_background"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_btn_tree"
                android:textSize="9sp"
                android:textColor="@color/widget_cta_text"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center"
                android:maxLines="2" />

        </LinearLayout>

        <View android:layout_width="4dp" android:layout_height="match_parent" />

        <!-- 3 · Settings -->
        <LinearLayout
            android:id="@+id/widget_btn_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_button_background"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_btn_settings"
                android:textSize="9sp"
                android:textColor="@color/widget_cta_text"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center"
                android:maxLines="2" />

        </LinearLayout>

        <View android:layout_width="4dp" android:layout_height="match_parent" />

        <!-- 4 · + Extra (log an extra activity to earn a flower) -->
        <LinearLayout
            android:id="@+id/widget_btn_extra"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_button_background"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_btn_extra"
                android:textSize="9sp"
                android:textColor="@color/widget_cta_text"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center"
                android:maxLines="2" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
