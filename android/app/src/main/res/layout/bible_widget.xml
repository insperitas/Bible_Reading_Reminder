<?xml version="1.0" encoding="utf-8"?>
<!--
  Portrait widget: tree image fills the top, small date/streak row, two stacked buttons.
  RemoteViews supported types: LinearLayout, ImageView, TextView.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <!-- Tree image (takes all available space) -->
    <ImageView
        android:id="@+id/widget_tree_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_tree_placeholder"
        android:contentDescription="@string/widget_character_desc" />

    <!-- Date + streak -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_date_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/widget_text_secondary"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <!-- Water button (full width) -->
    <LinearLayout
        android:id="@+id/widget_btn_water"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_button_background"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_btn_water"
            android:textSize="11sp"
            android:textColor="@color/widget_cta_text"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Feed button (full width) -->
    <LinearLayout
        android:id="@+id/widget_btn_feed"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_button_background"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_btn_feed"
            android:textSize="11sp"
            android:textColor="@color/widget_cta_text"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

</LinearLayout>
